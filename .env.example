# Google Analytics 4 – measurement ID (np. G-XXXXXXXXXX)
# Ładowane tylko w produkcji. Pozostaw puste, by wyłączyć.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Resend – klucz API do wysyłki maili z formularza kontaktowego.
# https://resend.com/api-keys
RESEND_API_KEY=

# OpenAI – używane przez /api/tax-ai i /api/car-recommend do wykrywania stawek/kosztów.
OPENAI_API_KEY=

# OVH API, zarzadzanie strefa DNS domeny (opcjonalne, tylko do skryptow)
OVH_ENDPOINT=ovh-eu
OVH_APPLICATION_KEY=
OVH_APPLICATION_SECRET=
OVH_CONSUMER_KEY=

# Resend z pelnym dostepem, tylko do skryptow administracyjnych
RESEND_API_KEY_FULL=
